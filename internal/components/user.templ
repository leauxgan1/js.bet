package components

import (
	"js-bet/internal/game"
)

// Show user their name and gold amount, updated when they win or lose a bet
templ Profile(userState game.UserState) {
	<hx-partial hx-target="#player-info" hx-swap="outerMorph">
	  <div id="player-info">
			<h1> {userState.UserName} </h1>
			<p> {userState.Gold} </p>
		</div>  
	</hx-partial>
}
