package components


templ Popup() {
  <div id="popup">
		<button hx-on:click="this.parentElement.setAttribute('hidden',true)">X</button>
    {children...}
  </div>
}


templ PopupLogin() {
  @Popup() {
  	<h1> Sign up / Log in to JS.bet </h1>
  	<form action="/user/login" method="post">
  		<input type="text" name="name">
  		<input type="text" name="pass">
  		<button type="submit" hx-post="/user/login">Submit </button>
  	</form>
  }
}

templ PopupAbout() {
  @Popup() {
  	<h1> About </h1>
  	<p> This is a virtual fighting simulation between JS frameworks! </p>
  	<p> Login to create an account and start earning gold by making safe bets... or just bet on your favorite each time :> </p>
  }
}


